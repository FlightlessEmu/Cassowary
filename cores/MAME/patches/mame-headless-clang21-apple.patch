 static int os_execute (lua_State *L) {
   const char *cmd = luaL_optstring(L, 1, NULL);
+#if defined(__APPLE__) && (TARGET_OS_IOS || TARGET_OS_TV)
+  /* system() is unavailable on iOS and tvOS. MAME only uses Lua for plugins
