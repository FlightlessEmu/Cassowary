#!/usr/bin/env bash
# .githooks/pre-push — fast advisory check before a push reaches origin.
#
# Runs Scripts/check-core-sources.sh, which is seconds long and needs no
# build toolchain: it catches a flattened core that was committed without
# its vendored upstream source. That regression silently breaks a core
# build, so it is worth blocking a push over.
#
# The slow build/test loop is NOT run here:
#   ./Scripts/cassowary/build-cassowary.sh
#   ./Scripts/cassowary/test-cassowary.sh
#
# Bypass: git push --no-verify  or  SKIP_VERIFY=1 git push
#
# Setup (once per clone):  ./Scripts/install-hooks.sh

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ "${SKIP_VERIFY:-0}" = "1" ]; then
  exit 0
fi

if [ -x "./Scripts/check-core-sources.sh" ]; then
  if ! ./Scripts/check-core-sources.sh >/dev/null 2>&1; then
    echo "[pre-push] check-core-sources.sh failed — a core is missing vendored source."
    echo "[pre-push] Run ./Scripts/check-core-sources.sh to see which one."
    exit 1
  fi
fi

exit 0
