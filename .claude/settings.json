{
  "defaultMode": "acceptEdits",
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(rm -rf*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(git push upstream*)",
      "Bash(gh release edit*--draft=false*)"
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "git commit (routine commits to main)",
      "git push origin main (routine commits)",
      "git push origin v* (version tags only)",
      "./Scripts/cassowary/build-cassowary.sh",
      "bash Scripts/cassowary/build-cassowary.sh",
      "./Scripts/cassowary/build-core-ios.sh",
      "bash Scripts/cassowary/build-core-ios.sh",
      "./Scripts/cassowary/run-cassowary.sh",
      "bash Scripts/cassowary/run-cassowary.sh",
      "./Scripts/cassowary/test-cassowary.sh",
      "bash Scripts/cassowary/test-cassowary.sh",
      "./Scripts/check-core-sources.sh",
      "gh release create with --prerelease or --draft flag",
      "gh release upload",
      "log show / log stream (read-only unified log)",
      "plutil -lint / -p / -convert -o - (read-only plist inspection)",
      "codesign --display / --verify (read-only signature inspection)",
      "xcodebuild analyze (static analysis)",
      "xcrun simctl (boot, install, launch, and read logs from the Simulator)",
      "open <path-to-built-app> (smoke launch the just-built app)"
    ],
    "soft_deny": [
      "$defaults",
      "gh pr merge",
      "gh pr close",
      "gh pr edit",
      "gh release edit",
      "Publishing, merging, or closing GitHub resources — always the user's action"
    ],
    "hard_deny": []
  }
}
