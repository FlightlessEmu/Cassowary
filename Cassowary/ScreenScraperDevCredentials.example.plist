<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App key for ScreenScraper (the optional second cover art source).

  To use it, copy this file to Cassowary/Resources/ScreenScraperDevCredentials.plist
  and fill in the two values. That file is not committed — never commit app keys.

  Where to get the values: screenscraper.fr → Developer area → My API credentials.
  The easiest place to enter them instead is in the app, under
  Settings → Cover Art → ScreenScraper → App Key, which needs no rebuild.

  devid and devpassword identify the software to the ScreenScraper API. They are
  required for any lookup; a user account (entered in Settings) is optional and
  only raises the daily lookup limit.
-->
<plist version="1.0">
<dict>
	<key>devid</key>
	<string></string>
	<key>devpassword</key>
	<string></string>
</dict>
</plist>
